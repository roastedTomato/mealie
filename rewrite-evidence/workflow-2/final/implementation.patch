diff --git a/frontend-react/src/features/admin/Data.tsx b/frontend-react/src/features/admin/Data.tsx
new file mode 100644
index 000000000..e7a402616
--- /dev/null
+++ b/frontend-react/src/features/admin/Data.tsx
@@ -0,0 +1,370 @@
+import { useState, type FormEvent } from "react";
+import {
+  Alert,
+  Button,
+  Dialog,
+  DialogContent,
+  DialogTitle,
+  MenuItem,
+  Stack,
+  Table,
+  TableBody,
+  TableCell,
+  TableRow,
+  TextField,
+  Typography,
+} from "@mui/material";
+import { Link, useNavigate, useParams } from "react-router";
+import {
+  api,
+  post,
+  put,
+  remove,
+  useResource,
+  errorMessage,
+  type Page,
+} from "../../shared/api";
+import { PageTitle, Section, ResourceStatus, NavLinks } from "../../shared/ui";
+import { RecordForm } from "../../shared/RecordForm";
+import { useText } from "../../shared/useText";
+import type {
+  ReportOut,
+  ReportSummary,
+} from "../../../../frontend/app/lib/api/types/reports";
+interface Dataset {
+  title: string;
+  path: string;
+  defaults: Record<string, unknown>;
+}
+const datasets: Record<string, Dataset> = {
+  foods: {
+    title: "Food Data",
+    path: "/api/foods",
+    defaults: { name: "", description: "" },
+  },
+  units: {
+    title: "Units",
+    path: "/api/units",
+    defaults: {
+      name: "",
+      description: "",
+      abbreviation: "",
+      fraction: true,
+      useAbbreviation: false,
+    },
+  },
+  labels: {
+    title: "Labels",
+    path: "/api/groups/labels",
+    defaults: { name: "", color: "#e58325" },
+  },
+  categories: {
+    title: "Category Data",
+    path: "/api/organizers/categories",
+    defaults: { name: "" },
+  },
+  tags: {
+    title: "Tag Data",
+    path: "/api/organizers/tags",
+    defaults: { name: "" },
+  },
+  tools: {
+    title: "Tool Data",
+    path: "/api/organizers/tools",
+    defaults: { name: "" },
+  },
+  "recipe-actions": {
+    title: "Recipe Actions Data",
+    path: "/api/households/recipe-actions",
+    defaults: { title: "", url: "", actionType: "link" },
+  },
+  recipes: {
+    title: "Recipe Data",
+    path: "/api/recipes",
+    defaults: { name: "" },
+  },
+};
+export function DataPage() {
+  const { dataset = "foods" } = useParams();
+  const t = useText();
+  const config = datasets[dataset];
+  const result = useResource<Page<Record<string, unknown>>>(
+    config ? `${config.path}?perPage=-1` : null,
+  );
+  const [editing, setEditing] = useState<Record<string, unknown> | null>(null);
+  const [error, setError] = useState("");
+  const [exported, setExported] = useState("");
+  return (
+    <>
+      <PageTitle>{t("Data Management")}</PageTitle>
+      <Typography sx={{ mb: 2 }}>
+        {t("Select which data set you want to make changes to.")}
+      </Typography>
+      <NavLinks
+        links={Object.entries(datasets).map(([k, x]) => [
+          t(x.title),
+          `/group/data/${k}`,
+        ])}
+      />
+      {config ? (
+        <>
+          <Section title={t(config.title)}>
+            <ResourceStatus
+              loading={result.loading}
+              error={result.error || error}
+            />
+            <Button onClick={() => setEditing(config.defaults)}>
+              {t("Create")}
+            </Button>
+            <Table>
+              <TableBody>
+                {result.data?.items.map((x) => (
+                  <TableRow key={String(x.id)}>
+                    <TableCell>{String(x.name ?? x.title ?? "")}</TableCell>
+                    <TableCell>
+                      <Button onClick={() => setEditing(x)}>{t("Edit")}</Button>
+                      <Button
+                        onClick={() => {
+                          if (window.confirm(t("Delete this record?")))
+                            void remove(
+                              `${config.path}/${dataset === "recipes" ? x.slug : x.id}`,
+                            )
+                              .then(result.reload)
+                              .catch((e: unknown) => setError(errorMessage(e)));
+                        }}
+                      >
+                        {t("Delete")}
+                      </Button>
+                    </TableCell>
+                  </TableRow>
+                ))}
+              </TableBody>
+            </Table>
+          </Section>
+          {dataset === "recipes" && (
+            <Section title={t("Data Exports")}>
+              <Button
+                onClick={() =>
+                  void post<{ id?: string }>(
+                    "/api/recipes/bulk-actions/export",
+                    {
+                      recipes: result.data?.items.map((x) => x.id) ?? [],
+                      exportType: "json",
+                    },
+                  )
+                    .then((x) => setExported(JSON.stringify(x)))
+                    .catch((e: unknown) => setError(errorMessage(e)))
+                }
+              >
+                {t("Export")}
+              </Button>
+              {exported && <Typography>{exported}</Typography>}
+            </Section>
+          )}
+          <Dialog
+            open={Boolean(editing)}
+            onClose={() => setEditing(null)}
+            fullWidth
+          >
+            <DialogTitle>{t(editing?.id ? "Edit" : "Create")}</DialogTitle>
+            <DialogContent>
+              {editing && (
+                <RecordForm
+                  value={editing}
+                  omit={["id", "groupId", "slug", "householdId"]}
+                  onSave={async (value) => {
+                    if (value.id)
+                      await put(
+                        `${config.path}/${dataset === "recipes" ? value.slug : value.id}`,
+                        value,
+                      );
+                    else await post(config.path, value);
+                    setEditing(null);
+                    result.reload();
+                  }}
+                />
+              )}
+            </DialogContent>
+          </Dialog>
+        </>
+      ) : (
+        <Alert severity="error">Unknown dataset</Alert>
+      )}
+    </>
+  );
+}
+export function Integrations() {
+  const { integration = "webhooks" } = useParams();
+  const t = useText();
+  const webhook = integration === "webhooks";
+  const path = webhook
+    ? "/api/households/webhooks"
+    : "/api/households/events/notifications";
+  const result = useResource<Page<Record<string, unknown>>>(
+    `${path}?perPage=-1`,
+  );
+  const [editing, setEditing] = useState<Record<string, unknown> | null>(null);
+  const [error, setError] = useState("");
+  return (
+    <>
+      <PageTitle>{t(webhook ? "Webhooks" : "Event Notifiers")}</PageTitle>
+      <ResourceStatus loading={result.loading} error={result.error || error} />
+      <Button
+        onClick={() =>
+          setEditing(
+            webhook
+              ? {
+                  name: "",
+                  url: "",
+                  scheduledTime: "00:00",
+                  enabled: true,
+                  webhookType: "mealplan",
+                }
+              : { name: "", appriseUrl: "" },
+          )
+        }
+      >
+        {t("Create")}
+      </Button>
+      {result.data?.items.map((x) => (
+        <Stack direction="row" key={String(x.id)} alignItems="center">
+          <Typography>{String(x.name)}</Typography>
+          <Button onClick={() => setEditing(x)}>{t("Edit")}</Button>
+          <Button
+            onClick={() =>
+              void post(`${path}/${x.id}/test`).catch((e: unknown) =>
+                setError(errorMessage(e)),
+              )
+            }
+          >
+            {t("Test")}
+          </Button>
+          <Button
+            onClick={() =>
+              void remove(`${path}/${x.id}`)
+                .then(result.reload)
+                .catch((e: unknown) => setError(errorMessage(e)))
+            }
+          >
+            {t("Delete")}
+          </Button>
+        </Stack>
+      ))}
+      <Dialog
+        open={Boolean(editing)}
+        onClose={() => setEditing(null)}
+        fullWidth
+      >
+        <DialogTitle>{t("Edit")}</DialogTitle>
+        <DialogContent>
+          {editing && (
+            <RecordForm
+              value={editing}
+              omit={["id", "groupId", "householdId"]}
+              onSave={async (values) => {
+                if (values.id) await put(`${path}/${values.id}`, values);
+                else await post(path, values);
+                setEditing(null);
+                result.reload();
+              }}
+            />
+          )}
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
+export function Migrations() {
+  const t = useText();
+  const navigate = useNavigate();
+  const reports = useResource<ReportSummary[]>(
+    "/api/groups/reports?report_type=migration",
+  );
+  const [kind, setKind] = useState("mealie_alpha");
+  const [file, setFile] = useState<File | null>(null);
+  const [error, setError] = useState("");
+  async function submit(e: FormEvent) {
+    e.preventDefault();
+    if (!file) return;
+    const body = new FormData();
+    body.append("archive", file);
+    body.append("migration_type", kind);
+    body.append("add_migration_tag", "true");
+    try {
+      const x = await api<ReportSummary>("/api/groups/migrations", {
+        method: "POST",
+        body,
+      });
+      navigate(`/group/reports/${x.id}`);
+    } catch (err) {
+      setError(errorMessage(err));
+    }
+  }
+  return (
+    <>
+      <PageTitle>{t("Recipe Data Migrations")}</PageTitle>
+      <Section title={t("New Migration")}>
+        <Stack component="form" onSubmit={submit} spacing={2}>
+          <TextField
+            select
+            label={t("Migration Type")}
+            value={kind}
+            onChange={(e) => setKind(e.target.value)}
+          >
+            {[
+              "mealie_alpha",
+              "nextcloud",
+              "chowdown",
+              "copymethat",
+              "paprika",
+              "tandoor",
+              "plantoeat",
+              "myrecipebox",
+              "recipekeeper",
+              "cookn",
+            ].map((x) => (
+              <MenuItem value={x} key={x}>
+                {x}
+              </MenuItem>
+            ))}
+          </TextField>
+          <Typography>{t("Upload File")}</Typography>
+          <input
+            type="file"
+            aria-label={t("Upload File")}
+            onChange={(e) => setFile(e.target.files?.[0] ?? null)}
+          />
+          <Button disabled={!file} type="submit">
+            {t("Start")}
+          </Button>
+        </Stack>
+      </Section>
+      <ResourceStatus
+        loading={reports.loading}
+        error={reports.error || error}
+      />
+      {reports.data?.map((x) => (
+        <Typography component={Link} key={x.id} to={`/group/reports/${x.id}`}>
+          {x.name}
+        </Typography>
+      ))}
+    </>
+  );
+}
+export function Report() {
+  const { id } = useParams();
+  const t = useText();
+  const result = useResource<ReportOut>(`/api/groups/reports/${id}`);
+  return (
+    <>
+      <PageTitle>{t("Report")}</PageTitle>
+      <ResourceStatus loading={result.loading} error={result.error} />
+      <Typography component="h2">{result.data?.name}</Typography>
+      {result.data?.entries?.map((x) => (
+        <Alert severity={x.success ? "success" : "error"} key={x.id}>
+          {x.message}
+        </Alert>
+      ))}
+    </>
+  );
+}
diff --git a/frontend-react/src/features/admin/Management.tsx b/frontend-react/src/features/admin/Management.tsx
new file mode 100644
index 000000000..f42bfe51b
--- /dev/null
+++ b/frontend-react/src/features/admin/Management.tsx
@@ -0,0 +1,392 @@
+import { useState, type FormEvent } from "react";
+import {
+  Alert,
+  Button,
+  Checkbox,
+  FormControlLabel,
+  MenuItem,
+  Stack,
+  Table,
+  TableBody,
+  TableCell,
+  TableHead,
+  TableRow,
+  TextField,
+  Typography,
+} from "@mui/material";
+import { Link, useNavigate, useParams } from "react-router";
+import {
+  get,
+  post,
+  put,
+  remove,
+  useResource,
+  errorMessage,
+  type Page,
+} from "../../shared/api";
+import type { UserIn, UserOut } from "../../shared/types";
+import { PageTitle, Section, ResourceStatus, NavLinks } from "../../shared/ui";
+import { RecordForm } from "../../shared/RecordForm";
+import { useText } from "../../shared/useText";
+interface Named {
+  id: string;
+  name: string;
+  groupId?: string;
+}
+export function AdminManagement() {
+  const { resource = "users", id } = useParams();
+  const t = useText();
+  const valid = ["users", "groups", "households"].includes(resource);
+  const base = valid ? `/api/admin/${resource}` : null;
+  const result = useResource<Record<string, unknown>>(
+    base ? (id ? `${base}/${id}` : `${base}?perPage=-1`) : null,
+  );
+  const [error, setError] = useState("");
+  const singular =
+    resource === "users"
+      ? "User"
+      : resource === "groups"
+        ? "Group"
+        : "Household";
+  const data = result.data;
+  const items =
+    data && Array.isArray(data.items)
+      ? (data.items as Record<string, unknown>[])
+      : [];
+  return (
+    <>
+      <PageTitle>{t(`${id ? "Admin " : ""}${singular} Management`)}</PageTitle>
+      <NavLinks
+        links={["users", "groups", "households"].map((x) => [
+          t(x[0]?.toUpperCase() + x.slice(1)),
+          `/admin/manage/${x}`,
+        ])}
+      />
+      <ResourceStatus loading={result.loading} error={result.error || error} />
+      {!valid && <Alert severity="error">Unknown resource</Alert>}
+      {id && data && !Array.isArray(data.items) ? (
+        <>
+          <Section
+            title={t(
+              resource === "users" ? "User Details" : `${singular} Preferences`,
+            )}
+          >
+            <RecordForm
+              value={data}
+              omit={[
+                "id",
+                "groupId",
+                "householdId",
+                "cacheKey",
+                "groupSlug",
+                "householdSlug",
+                "authMethod",
+              ]}
+              onSave={async (draft) => {
+                await put(`${base}/${id}`, draft);
+                result.reload();
+              }}
+            />
+          </Section>
+          {resource === "users" && (
+            <Section title={t("Permissions")}>
+              <Typography>
+                {t("Permissions are managed with the account flags above.")}
+              </Typography>
+            </Section>
+          )}
+          {Boolean(data.preferences) &&
+            typeof data.preferences === "object" && (
+              <Section title={t(`${singular} Preferences`)}>
+                <RecordForm
+                  value={data.preferences as Record<string, unknown>}
+                  omit={["id", "groupId"]}
+                  onSave={async (preferences) => {
+                    await put(`${base}/${id}`, { ...data, preferences });
+                    result.reload();
+                  }}
+                />
+              </Section>
+            )}
+        </>
+      ) : (
+        <>
+          {resource === "users" && (
+            <Button component={Link} to="/admin/manage/users/create">
+              {t("Create")}
+            </Button>
+          )}
+          <Table>
+            <TableHead>
+              <TableRow>
+                <TableCell>{t("Name")}</TableCell>
+                {resource === "users" && <TableCell>{t("Email")}</TableCell>}
+                <TableCell>{t("Actions")}</TableCell>
+              </TableRow>
+            </TableHead>
+            <TableBody>
+              {items.map((x) => (
+                <TableRow key={String(x.id)}>
+                  <TableCell>
+                    <Link to={`/admin/manage/${resource}/${x.id}`}>
+                      {String(x.name ?? x.fullName ?? x.username ?? "")}
+                    </Link>
+                  </TableCell>
+                  {resource === "users" && (
+                    <TableCell>{String(x.email ?? "")}</TableCell>
+                  )}
+                  <TableCell>
+                    <Button
+                      onClick={() => {
+                        if (window.confirm(t("Delete this record?")))
+                          void remove(`${base}/${x.id}`)
+                            .then(result.reload)
+                            .catch((e: unknown) => setError(errorMessage(e)));
+                      }}
+                    >
+                      {t("Delete")}
+                    </Button>
+                  </TableCell>
+                </TableRow>
+              ))}
+            </TableBody>
+          </Table>
+        </>
+      )}
+    </>
+  );
+}
+export function CreateUser() {
+  const t = useText();
+  const navigate = useNavigate();
+  const groups = useResource<Page<Named>>("/api/admin/groups?perPage=-1");
+  const households = useResource<Page<Named>>(
+    "/api/admin/households?perPage=-1",
+  );
+  const [draft, setDraft] = useState<UserIn>({
+    username: "",
+    fullName: "",
+    email: "",
+    password: "",
+    group: "",
+    household: "",
+    admin: false,
+    canManage: false,
+    canInvite: false,
+    canOrganize: false,
+  });
+  const [error, setError] = useState("");
+  async function submit(e: FormEvent) {
+    e.preventDefault();
+    try {
+      await post<UserOut>("/api/admin/users", draft);
+      navigate("/admin/manage/users");
+    } catch (err) {
+      setError(errorMessage(err));
+    }
+  }
+  return (
+    <>
+      <PageTitle>{t("Admin User Creation")}</PageTitle>
+      <Stack component="form" spacing={2} onSubmit={submit}>
+        <Section title={t("User Details")}>
+          <Stack spacing={2}>
+            <TextField
+              select
+              label={t("User Group")}
+              value={draft.group ?? ""}
+              onChange={(e) =>
+                setDraft({ ...draft, group: e.target.value, household: "" })
+              }
+              required
+            >
+              {groups.data?.items.map((x) => (
+                <MenuItem key={x.id} value={x.name}>
+                  {x.name}
+                </MenuItem>
+              ))}
+            </TextField>
+            <TextField
+              select
+              label={t("User Household")}
+              value={draft.household ?? ""}
+              onChange={(e) =>
+                setDraft({ ...draft, household: e.target.value })
+              }
+              required
+            >
+              {households.data?.items
+                .filter(
+                  (x) =>
+                    !draft.group ||
+                    x.groupId ===
+                      groups.data?.items.find((g) => g.name === draft.group)
+                        ?.id,
+                )
+                .map((x) => (
+                  <MenuItem key={x.id} value={x.name}>
+                    {x.name}
+                  </MenuItem>
+                ))}
+            </TextField>
+            {(["username", "fullName", "email", "password"] as const).map(
+              (key) => (
+                <TextField
+                  key={key}
+                  label={t(
+                    {
+                      username: "User Name",
+                      fullName: "Full Name",
+                      email: "Email",
+                      password: "Password",
+                    }[key],
+                  )}
+                  type={key === "password" ? "password" : "text"}
+                  slotProps={{ htmlInput: { role: "textbox" } }}
+                  value={draft[key]}
+                  required
+                  onChange={(e) =>
+                    setDraft({ ...draft, [key]: e.target.value })
+                  }
+                />
+              ),
+            )}
+          </Stack>
+        </Section>
+        <Section title={t("Permissions")}>
+          {(
+            [
+              "admin",
+              "canManage",
+              "canInvite",
+              "canOrganize",
+              "canManageHousehold",
+            ] as const
+          ).map((key) => (
+            <FormControlLabel
+              key={key}
+              label={key}
+              control={
+                <Checkbox
+                  checked={Boolean(draft[key])}
+                  onChange={(_, checked) =>
+                    setDraft({ ...draft, [key]: checked })
+                  }
+                />
+              }
+            />
+          ))}
+        </Section>
+        {error && <Alert severity="error">{error}</Alert>}
+        <Button type="submit">{t("Create")}</Button>
+      </Stack>
+    </>
+  );
+}
+export function Preferences({ household = false }: { household?: boolean }) {
+  const t = useText();
+  const scope = household ? "households" : "groups";
+  const result = useResource<Record<string, unknown>>(`/api/${scope}/self`);
+  const [error, setError] = useState("");
+  const preferences = result.data?.preferences;
+  return (
+    <>
+      <PageTitle>
+        {t(household ? "Household Settings" : "Group Settings")}
+      </PageTitle>
+      <NavLinks
+        links={
+          household
+            ? [
+                [t("Manage Members"), "/household/members"],
+                [t("Webhooks"), "/household/webhooks"],
+                [t("Event Notifiers"), "/household/notifiers"],
+                [t("Meal Plan Rules"), "/household/mealplan/settings"],
+              ]
+            : [
+                [t("Data Management"), "/group/data"],
+                [t("Recipe Data Migrations"), "/group/migrations"],
+              ]
+        }
+      />
+      <ResourceStatus loading={result.loading} error={result.error || error} />
+      <Section
+        title={t(household ? "Household Preferences" : "Group Preferences")}
+      >
+        {Boolean(preferences) && typeof preferences === "object" && (
+          <RecordForm
+            value={preferences as Record<string, unknown>}
+            omit={["id", "groupId"]}
+            onSave={async (values) => {
+              await put(`/api/${scope}/preferences`, values);
+              result.reload();
+            }}
+          />
+        )}
+      </Section>
+      {!household && (
+        <Button
+          onClick={() =>
+            void get("/api/groups/storage").catch((e: unknown) =>
+              setError(errorMessage(e)),
+            )
+          }
+        >
+          {t("Storage")}
+        </Button>
+      )}
+    </>
+  );
+}
+export function Members() {
+  const t = useText();
+  const result = useResource<Page<UserOut>>(
+    "/api/households/members?perPage=-1",
+  );
+  const [error, setError] = useState("");
+  const [invite, setInvite] = useState("");
+  return (
+    <>
+      <PageTitle>{t("Manage Members")}</PageTitle>
+      <ResourceStatus loading={result.loading} error={result.error || error} />
+      {result.data?.items.map((x) => (
+        <Stack key={x.id} direction="row" alignItems="center" spacing={2}>
