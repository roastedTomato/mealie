+        </Toolbar>
+      </AppBar>
+      {user && (
+        <Box sx={{ px: 3, pt: 2 }}>
+          <NavLinks
+            links={[
+              ["Recipes", `/g/${user.groupSlug}`],
+              ["Shopping Lists", "/shopping-lists"],
+              ["Meal Planner", "/household/mealplan/planner"],
+              ["Settings", "/household"],
+              ["Group Settings", "/group"],
+              ...(user.admin
