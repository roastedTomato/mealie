#!/usr/bin/env node
// POSIX-compatible subset used by measure.sh; macOS does not ship GNU timeout.
const {spawn}=require('node:child_process');
const [seconds,command,...args]=process.argv.slice(2);
if(!command||!Number.isFinite(Number(seconds))){process.stderr.write('usage: timeout SECONDS COMMAND [ARGS...]\n');process.exit(2);}
let timedOut=false;
const child=spawn(command,args,{stdio:'inherit',detached:true});
const terminate=signal=>{try{process.kill(-child.pid,signal);}catch{}};
const timer=setTimeout(()=>{timedOut=true;terminate('SIGTERM');setTimeout(()=>terminate('SIGKILL'),1000).unref();},Number(seconds)*1000);
for(const signal of ['SIGINT','SIGTERM','SIGHUP'])process.on(signal,()=>terminate(signal));
child.on('error',error=>{clearTimeout(timer);process.stderr.write(String(error)+'\n');process.exitCode=127;});
child.on('exit',(code,signal)=>{clearTimeout(timer);process.exitCode=timedOut?124:code??(signal?128:1);});
